# Copiez ce fichier en .env et ajustez les valeurs si nécessaire.
# L'API FastAPI lit DATABASE_URL au démarrage.

# PostgreSQL (Docker Compose)
DATABASE_URL=postgresql://barrage_user:barrage_pass@localhost:5432/barrage

# SQLite local (mode développement sans Docker)
# DATABASE_URL=sqlite:///./barrage.db
